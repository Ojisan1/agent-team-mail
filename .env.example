# Network (keep localhost unless a container or private network requires otherwise)
BIND_HOST=127.0.0.1
PORT=8765
ALLOWED_HOSTS=127.0.0.1:*,localhost:*,[::1]:*

# Outbound SMTP with STARTTLS
SMTP_HOST=mail.example.com
SMTP_PORT=587

# Inbox and Sent-folder access over IMAP SSL
IMAP_HOST=mail.example.com
IMAP_PORT=993
SENT_FOLDER=Sent

# Mailbox identity and credentials
BOT_ADDRESS=agent@example.com
MAIL_USERNAME=agent@example.com
MAIL_APP_PASSWORD=replace-with-an-app-password

# Fixed recipient/sender allowlist
TEAM_ADDRESSES=alice@example.com,bob@example.com
